# Junior Threat Intel Agent - Environment Variables
# Copy this to .env and fill in your API keys

# ===========================================
# REQUIRED: Google Threat Intelligence (VirusTotal)
# ===========================================
# Get from: https://www.virustotal.com/gui/my-apikey
VT_API_KEY=your_virustotal_api_key_here

# ===========================================
# REQUIRED: Feedly Threat Intelligence
# ===========================================
# Requires Feedly TI subscription
# Get from: https://feedly.com/i/account
FEEDLY_ACCESS_TOKEN=your_feedly_token_here

# ===========================================
# VERIFICATION AGENT: Additional Enrichment Sources
# ===========================================

# AbuseIPDB - IP reputation (used by verify-claims)
# Get from: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=your_abuseipdb_key_here

# AlienVault OTX - Threat intelligence pulses
# Get from: https://otx.alienvault.com/api
OTX_API_KEY=your_otx_key_here

# Shodan - Internet-connected device data
# Get from: https://account.shodan.io/
SHODAN_API_KEY=your_shodan_key_here

# ===========================================
# OPTIONAL: MISP Instance
# ===========================================
# Only if you have access to a MISP server
# MISP_URL=https://your-misp-instance.local
# MISP_API_KEY=your_misp_key_here

# ===========================================
# OPTIONAL: Google SecOps (Chronicle)
# ===========================================
# Only needed if deploying detections to SIEM
# CHRONICLE_CREDENTIALS=/path/to/credentials.json
