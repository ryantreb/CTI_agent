# Junior Threat Intel Agent - Environment Configuration
# Copy this file to .env and fill in your API keys
# NEVER commit .env to version control

# =============================================================================
# REQUIRED: Primary Intelligence Sources
# =============================================================================

# Feedly Threat Intelligence API Key
# Get from: https://feedly.com/i/team/api
FEEDLY_API_KEY=

# VirusTotal API Key (used by GTI MCP)
# Get from: https://www.virustotal.com/gui/my-apikey
VT_API_KEY=

# =============================================================================
# OPTIONAL: Additional Enrichment Sources
# =============================================================================

# AbuseIPDB API Key
# Get from: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# AlienVault OTX API Key
# Get from: https://otx.alienvault.com/api
OTX_API_KEY=

# IPinfo API Key (optional, has free tier without key)
# Get from: https://ipinfo.io/account/token
IPINFO_API_KEY=

# =============================================================================
# OPTIONAL: Operational Integration
# =============================================================================

# Google Chronicle / SecOps API Key
# Get from: Google Cloud Console
CHRONICLE_API_KEY=

# Chronicle Instance ID
CHRONICLE_INSTANCE=

# =============================================================================
# AGENT CONFIGURATION
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable self-evolving loop (true/false)
SELF_EVOLVING_ENABLED=true

# Maximum optimization attempts per session
MAX_OPTIMIZATION_ATTEMPTS=3

# Evaluation pass threshold (0.0-1.0)
EVAL_PASS_THRESHOLD=0.80

# =============================================================================
# OUTPUT CONFIGURATION
# =============================================================================

# Default TLP classification for reports
DEFAULT_TLP=AMBER

# Defang IOCs in reports (true/false)
DEFANG_IOCS=true

# Include raw API responses in reports (true/false)
INCLUDE_RAW_RESPONSES=false
