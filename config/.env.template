# ============================================
# CTI Agent v2.4.0 API Key Configuration
# ============================================
# Copy this file to config/.env and fill in your keys.
#
# 11 of 21 MCP servers require NO API keys and work immediately.
# The keys below unlock additional enrichment sources.

# === RECOMMENDED (Free tier available) ===
VT_API_KEY=                # VirusTotal / Google Threat Intelligence (free: 1000 req/day)
                           # Note: gti_mcp reads VT_APIKEY, fastmcp-threatintel reads VIRUSTOTAL_API_KEY
                           # Both are mapped from this single VT_API_KEY in MCP configs
OTX_API_KEY=               # AlienVault OTX (free, generous limits)
ABUSEIPDB_API_KEY=         # AbuseIPDB (free: 1000 req/day)
SHODAN_API_KEY=            # Shodan (free: 100 queries/month)

# === OPTIONAL (Free tier available) ===
CENSYS_PAT=                # Censys PAT (free: 250 queries/month) - https://search.censys.io/account/api
TI_MINDMAP_API_KEY=        # TI Mindmap HUB (free API key from ti-mindmap-hub.com/settings)

# === PAID (Subscription required) ===
# FEEDLY_ACCESS_TOKEN=     # Feedly — repo 404, package not on PyPI/npm (removed 2026-02-17)
# MALLORY_API_KEY=         # Mallory (closed beta — not publicly available)

# === NO API KEYS REQUIRED (11 servers) ===
# These work immediately with no configuration:
#   Enrichment:    mcp-threatintel (GreyNoise, abuse.ch)
#   Vulnerability: kev-mcp, vulnerability-intelligence-mcp, nuclei-mcp (requires Go toolchain)
#   OSINT:         mcp-dnstwist
#   Utility:       cyberchef-api-mcp
#   Malware:       ghidra-mcp, yara-mcp, capa-mcp, radare2-mcp, binwalk-mcp (requires docker compose plugin)

# === PROXY (Optional) ===
# HTTP_PROXY=
# HTTPS_PROXY=
